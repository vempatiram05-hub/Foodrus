# ── Database ──────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# ── Server ────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development             # development | staging | production
APP_VERSION=1.0.0
LOG_LEVEL=info                   # error | warn | info | debug

# ── Authentication ────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=24h
REFRESH_TOKEN_EXPIRY=7d

# ── Admin Bootstrap (first-run only) ─────────────────────────────────
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=

# ── Email (Mailgun) ───────────────────────────────────────────────────
MAILGUN_FROM_EMAIL=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_SMTP_USER=
MAILGUN_SMTP_PASS=
MAILGUN_HOST=smtp.mailgun.org
MAILGUN_PORT=587

# ── Email (Gmail SMTP fallback) ───────────────────────────────────────
EMAIL_USER=
EMAIL_PASS=

# ── SMS (ClickSend) ───────────────────────────────────────────────────
CLICKSEND_USERNAME=
CLICKSEND_API_KEY=

# ── Payment (Helcim) ──────────────────────────────────────────────────
HELCIM_API_TOKEN=
HELCIM_API_URL=https://api.helcim.com/v2/payment/purchase

# ── CORS ──────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000

# ── Rate Limiting ─────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000      # 15 minutes in ms
RATE_LIMIT_MAX_GENERAL=1000      # requests per window for general API
RATE_LIMIT_MAX_AUTH=100          # requests per window for auth endpoints

# ── Signed URL ────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
LOCAL_URL_SECRET=

# ── Hashing ───────────────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=10

# ── SSL (production DB connection) ────────────────────────────────────
# DB_SSL_CA=                     # PEM certificate for rejectUnauthorized:true
